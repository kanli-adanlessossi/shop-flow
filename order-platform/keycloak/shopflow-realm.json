{
  "realm": "shopflow",
  "enabled": true,
  "displayName": "ShopFlow",
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "roles": {
    "realm": [
      { "name": "customer", "description": "Places and views their own orders" },
      { "name": "admin", "description": "Manages all orders and reads reports" }
    ]
  },
  "clients": [
    {
      "clientId": "shopflow-web",
      "name": "ShopFlow test client",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": [ "http://localhost:*" ],
      "webOrigins": [ "+" ],
      "attributes": { "pkce.code.challenge.method": "S256" }
    },
    {
      "clientId": "shopflow-service",
      "name": "ShopFlow service client (client credentials, no user)",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "shopflow-service-secret",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false
    }
  ],
  "users": [
    {
      "username": "service-account-shopflow-service",
      "enabled": true,
      "serviceAccountClientId": "shopflow-service",
      "realmRoles": [ "admin" ]
    },
    {
      "username": "alice",
      "email": "alice@shopflow.test",
      "emailVerified": true,
      "firstName": "Alice",
      "lastName": "Customer",
      "enabled": true,
      "credentials": [ { "type": "password", "value": "alice-pass", "temporary": false } ],
      "realmRoles": [ "customer" ]
    },
    {
      "username": "bob",
      "email": "bob@shopflow.test",
      "emailVerified": true,
      "firstName": "Bob",
      "lastName": "Admin",
      "enabled": true,
      "credentials": [ { "type": "password", "value": "bob-pass", "temporary": false } ],
      "realmRoles": [ "admin" ]
    }
  ]
}
