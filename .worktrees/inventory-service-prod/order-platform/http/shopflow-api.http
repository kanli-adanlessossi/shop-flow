# ShopFlow order-platform: every endpoint and every error case.
#
# Format: VS Code "REST Client" extension (humao.rest-client). Click "Send Request" above a
# request, or run them from top to bottom. Requests depend on each other only through named
# responses (for example createV2), so the file works on a database that already has data.
#
# Start the app first, from the repo root:
#   ./mvnw -pl order-platform spring-boot:run     (Docker Compose starts Postgres, Kafka, Keycloak)
#
# Every request except /actuator/health needs "Authorization: Bearer <token>". Requests use
# alice's token (customer); /api/admin/** needs bob's (admin). See section 0 and section 11.
#
# "# expect: NNN" states the status each request should return.
#
# API versions: v2 is the default and v1 is deprecated (it adds Deprecation and Sunset headers).
# The version can be sent as a header (X-API-Version), a query parameter (api-version) or a
# vendor media type (Accept: application/vnd.shopflow.v1+json). The first one found wins.

@host = http://localhost:8080
@json = application/json

# Keycloak (started by Docker Compose together with the app). Users of the "shopflow" realm:
#   alice / alice-pass  role customer      bob / bob-pass  role admin
# Orders belong to the user named in "customerId": alice's requests use "alice" (a customer may only
# touch their own orders; an admin may touch any).
# Section 0 shows both ways to get a token: the password grant (a user signs in) and client credentials
# (a service signs in as itself, with a client id and secret). Send those requests first; the others reuse
# the tokens. @serviceToken (client credentials, role admin) is used only in section 11.
# Tokens last 5 minutes (Keycloak default): send the sign-in request again when you get a 401.
@keycloak = http://localhost:8180
@customerToken = {{loginAlice.response.body.$.access_token}}
@adminToken = {{loginBob.response.body.$.access_token}}
@serviceToken = {{loginService.response.body.$.access_token}}

###############################################################################################
# 0. Sign in (password grant of the test client shopflow-web; for local testing only)
###############################################################################################

### Sign in as alice (customer)
# @name loginAlice
# expect: 200
POST {{keycloak}}/realms/shopflow/protocol/openid-connect/token
Content-Type: application/x-www-form-urlencoded

grant_type=password&client_id=shopflow-web&username=alice&password=alice-pass

### Sign in as bob (admin)
# @name loginBob
# expect: 200
POST {{keycloak}}/realms/shopflow/protocol/openid-connect/token
Content-Type: application/x-www-form-urlencoded

grant_type=password&client_id=shopflow-web&username=bob&password=bob-pass

### Sign in as the service client (client credentials: no user, the client itself has the admin role)
# @name loginService
# expect: 200
POST {{keycloak}}/realms/shopflow/protocol/openid-connect/token
Content-Type: application/x-www-form-urlencoded

grant_type=client_credentials&client_id=shopflow-service&client_secret=shopflow-service-secret

###############################################################################################
# 1. Service
###############################################################################################

### Actuator health (UP)
# expect: 200
GET {{host}}/actuator/health

### Health info, version 1 (flat profiles list, full build info, Deprecation header)
# expect: 200
GET {{host}}/api/health-info
Authorization: Bearer {{customerToken}}
X-API-Version: 1

### Health info, version 2 (compact), also the default when no version is sent
# expect: 200
GET {{host}}/api/health-info
Authorization: Bearer {{customerToken}}
X-API-Version: 2

### Health info with no version (default is 2)
# expect: 200
GET {{host}}/api/health-info
Authorization: Bearer {{customerToken}}

### Health info with an unsupported version (problem detail)
# expect: 400
GET {{host}}/api/health-info
Authorization: Bearer {{customerToken}}
X-API-Version: 3

###############################################################################################
# 2. Ways to choose the API version
###############################################################################################

### Version through the api-version query parameter
# expect: 200
GET {{host}}/api/health-info?api-version=1
Authorization: Bearer {{customerToken}}

### Version through a vendor media type in Accept
# expect: 200
GET {{host}}/api/health-info
Authorization: Bearer {{customerToken}}
Accept: application/vnd.shopflow.v1+json

### Header wins over query parameter (header says 2, query says 1)
# expect: 200
GET {{host}}/api/health-info?api-version=1
Authorization: Bearer {{customerToken}}
X-API-Version: 2

### A leading "v" is accepted (v2)
# expect: 200
GET {{host}}/api/health-info
Authorization: Bearer {{customerToken}}
X-API-Version: v2

###############################################################################################
# 3. Create orders (POST)
###############################################################################################

### Create, version 1 (no status, no totals; Location points at the new order)
# @name createV1
# expect: 201
POST {{host}}/api/orders
Authorization: Bearer {{customerToken}}
Content-Type: {{json}}
X-API-Version: 1

{
  "customerId": "alice",
  "discountCode": "WELCOME",
  "lines": [
    { "sku": "A", "quantity": 2, "unitPrice": 10.50 },
    { "sku": "B", "quantity": 1, "unitPrice": 3.25 }
  ]
}

### Create, version 2 (adds status, lineTotal and totals)
# @name createV2
# expect: 201
POST {{host}}/api/orders
Authorization: Bearer {{customerToken}}
Content-Type: {{json}}
X-API-Version: 2

{
  "customerId": "alice",
  "discountCode": "WELCOME",
  "lines": [
    { "sku": "A", "quantity": 2, "unitPrice": 10.50 },
    { "sku": "B", "quantity": 1, "unitPrice": 3.25 }
  ]
}

### Create with no version header (default version 2), no discount code
# @name createDefault
# expect: 201
POST {{host}}/api/orders
Authorization: Bearer {{customerToken}}
Content-Type: {{json}}

{
  "customerId": "alice",
  "lines": [
    { "sku": "Z", "quantity": 4, "unitPrice": 2.00 }
  ]
}

### Create an order to be confirmed (used by the conflict tests)
# @name createToPay
# expect: 201
POST {{host}}/api/orders
Authorization: Bearer {{customerToken}}
Content-Type: {{json}}

{
  "customerId": "alice",
  "lines": [
    { "sku": "P", "quantity": 1, "unitPrice": 99.99 }
  ]
}

### Create an order to be cancelled and then deleted
# @name createToCancel
# expect: 201
POST {{host}}/api/orders
Authorization: Bearer {{customerToken}}
Content-Type: {{json}}

{
  "customerId": "alice",
  "lines": [
    { "sku": "C", "quantity": 3, "unitPrice": 5.00 }
  ]
}

### Create an order that stays waiting for payment and is deleted directly
# @name createToDelete
# expect: 201
POST {{host}}/api/orders
Authorization: Bearer {{customerToken}}
Content-Type: {{json}}

{
  "customerId": "alice",
  "lines": [
    { "sku": "D", "quantity": 1, "unitPrice": 1.00 }
  ]
}

### Create: several validation errors at once (400 with a per-field errors list)
# expect: 400
POST {{host}}/api/orders
Authorization: Bearer {{customerToken}}
Content-Type: {{json}}

{
  "customerId": " ",
  "lines": [
    { "sku": "", "quantity": 0, "unitPrice": 5.00 },
    { "sku": "B", "quantity": -1, "unitPrice": 5.00 }
  ]
}

### Create: no lines (400)
# expect: 400
POST {{host}}/api/orders
Authorization: Bearer {{customerToken}}
Content-Type: {{json}}

{ "customerId": "alice", "lines": [] }

### Create: missing unitPrice (400)
# expect: 400
POST {{host}}/api/orders
Authorization: Bearer {{customerToken}}
Content-Type: {{json}}

{ "customerId": "alice", "lines": [ { "sku": "A", "quantity": 1 } ] }

### Create: zero or negative unitPrice (400)
# expect: 400
POST {{host}}/api/orders
Authorization: Bearer {{customerToken}}
Content-Type: {{json}}

{ "customerId": "alice", "lines": [ { "sku": "A", "quantity": 1, "unitPrice": -1 } ] }

### Create: unitPrice with three decimals (400, at most 2 allowed)
# expect: 400
POST {{host}}/api/orders
Authorization: Bearer {{customerToken}}
Content-Type: {{json}}

{ "customerId": "alice", "lines": [ { "sku": "A", "quantity": 1, "unitPrice": 1.234 } ] }

### Create: malformed JSON (400)
# expect: 400
POST {{host}}/api/orders
Authorization: Bearer {{customerToken}}
Content-Type: {{json}}

{ "customerId":

### Create: duplicate key in the body (400, strict duplicate detection)
# expect: 400
POST {{host}}/api/orders
Authorization: Bearer {{customerToken}}
Content-Type: {{json}}

{ "customerId": "a", "customerId": "b", "lines": [ { "sku": "A", "quantity": 1, "unitPrice": 1 } ] }

### Create: no body at all (400)
# expect: 400
POST {{host}}/api/orders
Authorization: Bearer {{customerToken}}
Content-Type: {{json}}

### Create: wrong content type (415)
# expect: 415
POST {{host}}/api/orders
Authorization: Bearer {{customerToken}}
Content-Type: text/plain

hello

### Create: unsupported API version (400)
# expect: 400
POST {{host}}/api/orders
Authorization: Bearer {{customerToken}}
Content-Type: {{json}}
X-API-Version: 3

{ "customerId": "alice", "lines": [ { "sku": "A", "quantity": 1, "unitPrice": 1 } ] }

###############################################################################################
# 4. Read orders (GET)
###############################################################################################

### Get one order, version 1
# expect: 200
GET {{host}}/api/orders/{{createV1.response.body.$.id}}
Authorization: Bearer {{customerToken}}
X-API-Version: 1

### Get one order, version 2 (status, lineTotal, totals)
# expect: 200
GET {{host}}/api/orders/{{createV2.response.body.$.id}}
Authorization: Bearer {{customerToken}}
X-API-Version: 2

### Get the same order again (served from the cache)
# expect: 200
GET {{host}}/api/orders/{{createV2.response.body.$.id}}
Authorization: Bearer {{customerToken}}

### Get an order that does not exist (404 problem detail with orderId)
# expect: 404
GET {{host}}/api/orders/999999999
Authorization: Bearer {{customerToken}}

### Get with an id that is not a number (400)
# expect: 400
GET {{host}}/api/orders/abc
Authorization: Bearer {{customerToken}}

### List, version 1 (id, customerId, createdAt; first page, newest first)
# expect: 200
GET {{host}}/api/orders?page=0&size=5
Authorization: Bearer {{customerToken}}
X-API-Version: 1

### List, version 2 (adds status and total)
# expect: 200
GET {{host}}/api/orders?page=0&size=5
Authorization: Bearer {{customerToken}}
X-API-Version: 2

### List, version 2, second page of size 2
# expect: 200
GET {{host}}/api/orders?page=1&size=2
Authorization: Bearer {{customerToken}}

### List, filtered by status
# expect: 200
GET {{host}}/api/orders?status=PENDING_PAYMENT
Authorization: Bearer {{customerToken}}

### List, sorted by total, highest first
# expect: 200
GET {{host}}/api/orders?sort=total,desc
Authorization: Bearer {{customerToken}}

### List, sorted by customer, A to Z
# expect: 200
GET {{host}}/api/orders?sort=customerId,asc
Authorization: Bearer {{customerToken}}

### List: a size above the maximum is capped at 100 (200)
# expect: 200
GET {{host}}/api/orders?size=100000
Authorization: Bearer {{customerToken}}

### List: unknown sort property (400)
# expect: 400
GET {{host}}/api/orders?sort=nope
Authorization: Bearer {{customerToken}}

### List: invalid status value (400)
# expect: 400
GET {{host}}/api/orders?status=NOPE
Authorization: Bearer {{customerToken}}

### Wrong method on a single order (405)
# expect: 405
POST {{host}}/api/orders/{{createV2.response.body.$.id}}
Authorization: Bearer {{customerToken}}
Content-Type: {{json}}

{}

###############################################################################################
# 5. Replace orders (PUT, only while PENDING_PAYMENT)
###############################################################################################

### Replace, version 1 (customer, discount code and all lines are replaced)
# expect: 200
PUT {{host}}/api/orders/{{createV1.response.body.$.id}}
Authorization: Bearer {{customerToken}}
Content-Type: {{json}}
X-API-Version: 1

{
  "customerId": "alice",
  "lines": [
    { "sku": "R", "quantity": 5, "unitPrice": 4.00 }
  ]
}

### The replaced order shows only the new line and new totals (cache was evicted)
# expect: 200
GET {{host}}/api/orders/{{createV1.response.body.$.id}}
Authorization: Bearer {{customerToken}}
X-API-Version: 2

### Replace, version 2
# expect: 200
PUT {{host}}/api/orders/{{createV2.response.body.$.id}}
Authorization: Bearer {{customerToken}}
Content-Type: {{json}}
X-API-Version: 2

{
  "customerId": "alice",
  "discountCode": "SPRING",
  "lines": [
    { "sku": "X", "quantity": 1, "unitPrice": 20.00 },
    { "sku": "Y", "quantity": 3, "unitPrice": 7.50 }
  ]
}

### Replace: validation errors (400)
# expect: 400
PUT {{host}}/api/orders/{{createV2.response.body.$.id}}
Authorization: Bearer {{customerToken}}
Content-Type: {{json}}

{ "customerId": "", "lines": [ { "sku": "A", "quantity": 0, "unitPrice": 1 } ] }

### Replace: order does not exist (404)
# expect: 404
PUT {{host}}/api/orders/999999999
Authorization: Bearer {{customerToken}}
Content-Type: {{json}}

{ "customerId": "alice", "lines": [ { "sku": "A", "quantity": 1, "unitPrice": 1 } ] }

###############################################################################################
# 6. Order status (PATCH, version 2 only)
###############################################################################################

### Mark an order as CONFIRMED
# expect: 200
PATCH {{host}}/api/orders/{{createToPay.response.body.$.id}}/status
Authorization: Bearer {{customerToken}}
Content-Type: {{json}}

{ "status": "CONFIRMED" }

### Status: missing status (400)
# expect: 400
PATCH {{host}}/api/orders/{{createToPay.response.body.$.id}}/status
Authorization: Bearer {{customerToken}}
Content-Type: {{json}}

{}

### Status: value that is not a status (400)
# expect: 400
PATCH {{host}}/api/orders/{{createToPay.response.body.$.id}}/status
Authorization: Bearer {{customerToken}}
Content-Type: {{json}}

{ "status": "NOPE" }

### Status: not available in version 1, which has no status (404)
# expect: 404
PATCH {{host}}/api/orders/{{createToPay.response.body.$.id}}/status
Authorization: Bearer {{customerToken}}
Content-Type: {{json}}
X-API-Version: 1

{ "status": "SHIPPED" }

### Status: order does not exist (404)
# expect: 404
PATCH {{host}}/api/orders/999999999/status
Authorization: Bearer {{customerToken}}
Content-Type: {{json}}

{ "status": "CONFIRMED" }

###############################################################################################
# 7. Conflicts: a CONFIRMED order can be neither replaced nor deleted (409)
###############################################################################################

### Replace a confirmed order (409 problem detail with orderStatus)
# expect: 409
PUT {{host}}/api/orders/{{createToPay.response.body.$.id}}
Authorization: Bearer {{customerToken}}
Content-Type: {{json}}

{ "customerId": "alice", "lines": [ { "sku": "A", "quantity": 1, "unitPrice": 1 } ] }

### Delete a confirmed order (409)
# expect: 409
DELETE {{host}}/api/orders/{{createToPay.response.body.$.id}}
Authorization: Bearer {{customerToken}}

### List of confirmed orders (only version 2 can filter by status)
# expect: 200
GET {{host}}/api/orders?status=CONFIRMED
Authorization: Bearer {{customerToken}}

###############################################################################################
# 8. Delete orders (DELETE, allowed while PENDING_PAYMENT or CANCELLED)
###############################################################################################

### Delete an order waiting for payment, version 1 (204; the same handler serves every version)
# expect: 204
DELETE {{host}}/api/orders/{{createToDelete.response.body.$.id}}
Authorization: Bearer {{customerToken}}
X-API-Version: 1

### The deleted order is gone (404)
# expect: 404
GET {{host}}/api/orders/{{createToDelete.response.body.$.id}}
Authorization: Bearer {{customerToken}}

### A customer cannot cancel an order (403, only admins may; the order stays as it was)
# expect: 403
PATCH {{host}}/api/orders/{{createToCancel.response.body.$.id}}/status
Authorization: Bearer {{customerToken}}
Content-Type: {{json}}

{ "status": "CANCELLED" }

### An admin cancels an order...
# expect: 200
PATCH {{host}}/api/orders/{{createToCancel.response.body.$.id}}/status
Authorization: Bearer {{adminToken}}
Content-Type: {{json}}

{ "status": "CANCELLED" }

### ...and delete it (204)
# expect: 204
DELETE {{host}}/api/orders/{{createToCancel.response.body.$.id}}
Authorization: Bearer {{customerToken}}

### Delete an order that does not exist (404)
# expect: 404
DELETE {{host}}/api/orders/999999999
Authorization: Bearer {{customerToken}}

### Delete with an id that is not a number (400)
# expect: 400
DELETE {{host}}/api/orders/abc
Authorization: Bearer {{customerToken}}

###############################################################################################
# 9. Sales report (admin; version 2 and later)
###############################################################################################

### Daily sales for the last 30 days (default range, gap days are zero rows)
# expect: 200
GET {{host}}/api/admin/reports/daily-sales
Authorization: Bearer {{adminToken}}

### Daily sales for an explicit range (both ends inclusive, UTC days)
# expect: 200
GET {{host}}/api/admin/reports/daily-sales?from=2026-11-01&to=2026-11-30
Authorization: Bearer {{adminToken}}

### Daily sales: only "from" (to defaults to today)
# expect: 200
GET {{host}}/api/admin/reports/daily-sales?from=2026-11-10
Authorization: Bearer {{adminToken}}

### Daily sales: "from" after "to" (400)
# expect: 400
GET {{host}}/api/admin/reports/daily-sales?from=2026-11-30&to=2026-11-01
Authorization: Bearer {{adminToken}}

### Daily sales: range longer than 366 days (400)
# expect: 400
GET {{host}}/api/admin/reports/daily-sales?from=2020-01-01&to=2026-11-30
Authorization: Bearer {{adminToken}}

### Daily sales: not a date (400)
# expect: 400
GET {{host}}/api/admin/reports/daily-sales?from=yesterday
Authorization: Bearer {{adminToken}}

### Daily sales: not available in version 1 (404)
# expect: 404
GET {{host}}/api/admin/reports/daily-sales
Authorization: Bearer {{adminToken}}
X-API-Version: 1

### Daily sales: unsupported version (400)
# expect: 400
GET {{host}}/api/admin/reports/daily-sales
Authorization: Bearer {{adminToken}}
X-API-Version: 3

###############################################################################################
# 10. Routing errors
###############################################################################################

### Unknown path (404)
# expect: 404
GET {{host}}/api/nothing-here
Authorization: Bearer {{customerToken}}

###############################################################################################
# 11. Authentication and roles
###############################################################################################

### No token (401)
# expect: 401
GET {{host}}/api/orders

### Token that is not a valid JWT (401)
# expect: 401
GET {{host}}/api/orders
Authorization: Bearer not.a.token

### Health stays public (200)
# expect: 200
GET {{host}}/actuator/health

### Admin report with no token (401)
# expect: 401
GET {{host}}/api/admin/reports/daily-sales

### Admin report as a customer (403)
# expect: 403
GET {{host}}/api/admin/reports/daily-sales
Authorization: Bearer {{customerToken}}

### Admin report as an admin (200)
# expect: 200
GET {{host}}/api/admin/reports/daily-sales
Authorization: Bearer {{adminToken}}

### An admin may also use the orders API (200)
# expect: 200
GET {{host}}/api/orders
Authorization: Bearer {{adminToken}}

### A service token (client credentials) works like an admin's (200)
# expect: 200
GET {{host}}/api/admin/reports/daily-sales
Authorization: Bearer {{serviceToken}}

### Bob (admin) places an order of his own (201)
# @name createBobs
# expect: 201
POST {{host}}/api/orders
Authorization: Bearer {{adminToken}}
Content-Type: {{json}}

{ "customerId": "bob", "lines": [ { "sku": "A", "quantity": 1, "unitPrice": 2.50 } ] }

### Alice reads bob's order (403, not hers)
# expect: 403
GET {{host}}/api/orders/{{createBobs.response.body.$.id}}
Authorization: Bearer {{customerToken}}

### Alice replaces bob's order (403)
# expect: 403
PUT {{host}}/api/orders/{{createBobs.response.body.$.id}}
Authorization: Bearer {{customerToken}}
Content-Type: {{json}}

{ "customerId": "alice", "lines": [ { "sku": "A", "quantity": 1, "unitPrice": 1 } ] }

### Alice changes the status of bob's order (403)
# expect: 403
PATCH {{host}}/api/orders/{{createBobs.response.body.$.id}}/status
Authorization: Bearer {{customerToken}}
Content-Type: {{json}}

{ "status": "SHIPPED" }

### Alice deletes bob's order (403)
# expect: 403
DELETE {{host}}/api/orders/{{createBobs.response.body.$.id}}
Authorization: Bearer {{customerToken}}

### Alice places an order in bob's name (403)
# expect: 403
POST {{host}}/api/orders
Authorization: Bearer {{customerToken}}
Content-Type: {{json}}

{ "customerId": "bob", "lines": [ { "sku": "A", "quantity": 1, "unitPrice": 1 } ] }

### Alice replaces her own order but names someone else as customer (403)
# expect: 403
PUT {{host}}/api/orders/{{createV2.response.body.$.id}}
Authorization: Bearer {{customerToken}}
Content-Type: {{json}}

{ "customerId": "bob", "lines": [ { "sku": "A", "quantity": 1, "unitPrice": 1 } ] }

### An admin reads alice's order (200)
# expect: 200
GET {{host}}/api/orders/{{createV2.response.body.$.id}}
Authorization: Bearer {{adminToken}}

### Alice reads an order that does not exist (404, not 403)
# expect: 404
GET {{host}}/api/orders/999999999
Authorization: Bearer {{customerToken}}

###############################################################################################
# 12. CORS (what a browser asks before calling the API from the web front end)
###############################################################################################

### Preflight from an allowed origin (200 with Access-Control-Allow-* headers, no token needed)
# expect: 200
OPTIONS {{host}}/api/orders
Origin: http://localhost:5173
Access-Control-Request-Method: POST
Access-Control-Request-Headers: authorization,content-type,x-api-version

### Preflight from an origin that is not allowed (403)
# expect: 403
OPTIONS {{host}}/api/orders
Origin: https://evil.example
Access-Control-Request-Method: POST
Access-Control-Request-Headers: authorization,content-type

### A real call from an allowed origin gets Access-Control-Allow-Origin back (200)
# expect: 200
GET {{host}}/api/orders?size=1
Authorization: Bearer {{customerToken}}
Origin: http://localhost:5173
